/* 全局重置 */
* {
    box-sizing: border-box;
}

/* 根容器：中间留更多空间 */
#root-container {
    background-color: transparent;
}

/* 基础玻璃面板 */
.glass-panel {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    padding: 15px;
    display: flex;
    flex-direction: column;
}

/* 标题文本 */
.header-text {
    -unity-font-style: bold;
    font-size: 14px;
    letter-spacing: 2px;
    color: white;
    margin-bottom: 5px;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 5px;
}

/* 正方形格子样式 */
.slot-square {
    width: 64px;
    height: 64px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    margin: 2px;
    justify-content: center;
    align-items: center;
    transition: all 0.1s ease;
    position: relative;
}
.slot-square:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border-color: white;
}
/* 结果格子高亮 */
.highlight {
    border-color: #50C8FF;
    background-color: rgba(80, 200, 255, 0.1);
}

/* 数量文本 */
.slot-count {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.8);
    -unity-font-style: bold;
}

/* 面板动画 */
.side-panel-base {
    transition: translate 0.4s ease, opacity 0.4s ease;
    opacity: 0;
    position: relative; /* 保证按钮绝对定位生效 */
}
.panel-hidden-left { translate: -120% 0; }
.panel-hidden-right { translate: 120% 0; }
.panel-visible { 
    translate: 0 0; 
    opacity: 1;
}

/* -------------------------- 核心：隐藏滚动条但保留滑动功能 -------------------------- */
.custom-scroll-view {
    --scrollbar-width: 8px;
    --scrollbar-track-color: rgba(255, 255, 255, 0.05);
    --scrollbar-thumb-color: rgba(255, 255, 255, 0.2);
    --scrollbar-thumb-hover: rgba(255, 255, 255, 0.4);
    --scrollbar-thumb-active: #50C8FF;
    --scrollbar-radius: 4px;
}

/* 滚动视图容器：调整内边距 */
.custom-scroll-view #unity-content-container {
    padding-right: 8px;
}

/* 隐藏垂直/水平滚动条（核心） */
.custom-scroll-view .unity-scroll-view__vertical-scrollbar,
.custom-scroll-view .unity-scroll-view__horizontal-scrollbar {
    display: none !important;
}

/* -------------------------- 左侧面板隐藏按钮（优化可点击性） -------------------------- */
.panel-toggle-btn {
    position: absolute;
    top: 10px;
    right: -15px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    transition: all 0.2s ease;
    z-index: 100; /* 提高层级，避免被遮挡 */
    picking-mode: position; /* 强制开启拾取，确保能点击 */
}
.panel-toggle-btn:hover {
    background-color: rgba(80, 200, 255, 0.2);
    border-color: #50C8FF;
}

/* -------------------------- 右侧底部功能按钮 -------------------------- */
.action-btn {
    width: 50px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    transition: all 0.1s ease;
}
.action-btn:hover {
    background-color: rgba(255, 255, 255, 0.25);
    border-color: #50C8FF;
}
.action-btn:active {
    background-color: rgba(80, 200, 255, 0.3);
}

/* 合成表项间距 */
#synthesis-list {
    padding-bottom: 10px;
}